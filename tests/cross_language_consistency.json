  "lookup_tests": [
    {
      "description": "Case-insensitive active lookup",
      "lookups": [
        "USD",
        "usd",
        "Usd",
        "uSd"
      ],
      "method": "active",
      "expected_code": "USD"
    },
    {
      "description": "Case-insensitive withdrawn lookup",
      "lookups": [
        "DEM",
        "dem",
        "Dem"
      ],
      "method": "withdrawn",
      "expected_code": "DEM"
    },
    {
      "description": "Case-insensitive non-ISO lookup",
      "lookups": [
        "BTC",
        "btc",
        "Btc"
      ],
      "method": "currency",
      "expected_code": "BTC"
    },
    {
      "description": "Nonexistent code returns null/nil/None",
      "lookups": [
        "XXX",
        "NOTACURRENCY"
      ],
      "method": "active",
      "expected_null": true
    }
  ],
  "filter_tests": [
    {
      "description": "Currencies pegged to USD",
      "method": "pegged_to",
      "argument": "USD",
      "argument_type": "string",
      "expected_contains": [
        "AED",
        "SAR",
        "QAR",
        "HKD"
      ]
    },
    {
      "description": "Currencies with 3 minor units",
      "method": "with_minor_units",
      "argument": 3,
      "argument_type": "integer",
      "expected_contains": [
        "KWD",
        "BHD",
        "OMR",
        "JOD",
        "TND",
        "LYD",
        "IQD"
      ]
    },
    {
      "description": "Independent currencies",
      "method": "independent",
      "expected_contains": [
        "USD",
        "EUR",
        "JPY",
        "GBP",
        "CHF"
      ],
      "expected_not_contains": [
        "AED",
        "SAR",
        "HKD"
      ]
    }
  ],
  "classification_tests": [
    {
      "description": "Fund codes and indexation units are classified",
      "expected": {
        "USD": "circulating",
        "EUR": "circulating",
        "CLF": "fund",
        "USN": "fund",
        "VED": "indexation"
      }
    },
    {
      "description": "Fund and indexation filtering",
      "method": "by_classification",
      "argument": "fund",
      "expected_contains": [
        "CLF",
        "USN",
        "CHE",
        "BOV"
      ],
      "expected_not_contains": [
        "USD",
        "EUR",
        "VED"
      ]
    }
  ],
  "summary_tests": [
    {
      "description": "Summary contains expected keys",
      "expected_keys": [
        "version",
        "updated",
        "active_currencies",
        "withdrawn_currencies",
        "non_iso_currencies",
        "pegged_currencies",
        "independent_currencies",
        "minor_units_distribution"
      ]
    }
  ],
  "malformed_registry_tests": {
    "description": "Registries every wrapper must reject (malformed) or accept (valid). A malformed registry fails at load with the wrapper's documented error type and a message \"malformed registry data: <path>: <reason>\" naming the JSON path below. Contract: docs/WRAPPER_VALIDATION.md. JavaScript cannot tell 2.0 from 2, so no case relies on that.",
    "max_minor_units": 36,
    "valid": [
      {"id": "empty_object", "registry": {}},
      {"id": "minimal_entry", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2}]}}},
      {"id": "minor_units_bounds", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 0}, {"code": "BBB", "name": "A", "minor_units": 36}]}}},
      {"id": "optional_fields_null", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "pegged_to": null, "peg_rate": null, "peg_band_pct": null, "countries": null, "code_lifetime": null, "is_independent": null, "market_cap_rank": null}]}}},
      {"id": "optional_fields_typed", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "pegged_to": "USD", "peg_rate": 1, "symbol": "$", "is_independent": false, "countries": [{"code": "US"}], "code_lifetime": {"from": null, "to": "2099-01"}}]}}},
      {"id": "unknown_fields_ignored", "registry": {"extra": 1, "currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "introduced": "1999", "iso_status": "x"}]}}}
    ],
    "malformed": [
      {"id": "root_array", "registry": [], "path": "$"},
      {"id": "root_string", "registry": "x", "path": "$"},
      {"id": "root_null", "registry": null, "path": "$"},
      {"id": "currencies_array", "registry": {"currencies": []}, "path": "$.currencies"},
      {"id": "currencies_null", "registry": {"currencies": null}, "path": "$.currencies"},
      {"id": "meta_array", "registry": {"meta": []}, "path": "$.meta"},
      {"id": "meta_version_number", "registry": {"meta": {"version": 1}}, "path": "$.meta.version"},
      {"id": "source_amendment_string", "registry": {"source": {"last_amendment_applied": "3"}}, "path": "$.source.last_amendment_applied"},
      {"id": "active_object", "registry": {"currencies": {"active": {}}}, "path": "$.currencies.active"},
      {"id": "active_null", "registry": {"currencies": {"active": null}}, "path": "$.currencies.active"},
      {"id": "non_iso_category_string", "registry": {"non_iso": {"stablecoins": "x"}}, "path": "$.non_iso.stablecoins"},
      {"id": "entry_not_object", "registry": {"currencies": {"active": [1]}}, "path": "$.currencies.active[0]"},
      {"id": "code_missing", "registry": {"currencies": {"active": [{"name": "A", "minor_units": 2}]}}, "path": "$.currencies.active[0].code"},
      {"id": "code_empty", "registry": {"currencies": {"active": [{"code": "", "name": "A", "minor_units": 2}]}}, "path": "$.currencies.active[0].code"},
      {"id": "code_number", "registry": {"currencies": {"active": [{"code": 5, "name": "A", "minor_units": 2}]}}, "path": "$.currencies.active[0].code"},
      {"id": "name_missing", "registry": {"currencies": {"active": [{"code": "AAA", "minor_units": 2}]}}, "path": "$.currencies.active[0].name"},
      {"id": "minor_units_missing", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A"}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "minor_units_string", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": "2"}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "minor_units_bool", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": true}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "minor_units_fraction", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2.5}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "minor_units_negative", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": -1}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "minor_units_above_max", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 37}]}}, "path": "$.currencies.active[0].minor_units"},
      {"id": "withdrawn_second_entry", "registry": {"currencies": {"withdrawn": [{"code": "AAA", "name": "A", "minor_units": 2}, {"code": "BBB", "name": "A", "minor_units": "x"}]}}, "path": "$.currencies.withdrawn[1].minor_units"},
      {"id": "non_iso_entry_null_minor_units", "registry": {"non_iso": {"cryptocurrencies": [{"code": "BTC", "name": "A", "minor_units": null}]}}, "path": "$.non_iso.cryptocurrencies[0].minor_units"},
      {"id": "peg_rate_string", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "peg_rate": "1.0"}]}}, "path": "$.currencies.active[0].peg_rate"},
      {"id": "is_independent_string", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "is_independent": "yes"}]}}, "path": "$.currencies.active[0].is_independent"},
      {"id": "market_cap_rank_fraction", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "market_cap_rank": 1.5}]}}, "path": "$.currencies.active[0].market_cap_rank"},
      {"id": "symbol_number", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "symbol": 5}]}}, "path": "$.currencies.active[0].symbol"},
      {"id": "countries_object", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "countries": {}}]}}, "path": "$.currencies.active[0].countries"},
      {"id": "country_not_object", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "countries": [1]}]}}, "path": "$.currencies.active[0].countries[0]"},
      {"id": "country_code_missing", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "countries": [{"name": "x"}]}]}}, "path": "$.currencies.active[0].countries[0].code"},
      {"id": "code_lifetime_array", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "code_lifetime": []}]}}, "path": "$.currencies.active[0].code_lifetime"},
      {"id": "code_lifetime_to_missing", "registry": {"currencies": {"active": [{"code": "AAA", "name": "A", "minor_units": 2, "code_lifetime": {"from": null}}]}}, "path": "$.currencies.active[0].code_lifetime.to"}
    ]
  },
  "numeric_contract": {
    "description": "Wrapper numeric contract (ADR 0013). Amounts are JSON numbers or the strings NaN, Infinity, -Infinity. An expected to_minor is an integer or {\"error\": \"non_finite\"|\"overflow\"}. Expected values are produced by tests/numeric_contract_oracle.py.",
    "vector_count": 83,
    "groups": [
      {"id": "rounding", "description": "to_minor and format on exact and near ties; half away from zero (D1), format from the same r (D5)", "vectors": [
        {"currency": "USD", "x": 0.005, "to_minor": 1, "format": "$0.01"},
        {"currency": "USD", "x": 0.015, "to_minor": 2, "format": "$0.02"},
        {"currency": "USD", "x": 0.025, "to_minor": 3, "format": "$0.03"},
        {"currency": "USD", "x": 0.125, "to_minor": 13, "format": "$0.13"},
        {"currency": "USD", "x": -0.005, "to_minor": -1, "format": "$-0.01"},
        {"currency": "USD", "x": -0.125, "to_minor": -13, "format": "$-0.13"},
        {"currency": "USD", "x": 1.005, "to_minor": 100, "format": "$1.00"},
        {"currency": "USD", "x": 100.005, "to_minor": 10001, "format": "$100.01"},
        {"currency": "USD", "x": -100.005, "to_minor": -10001, "format": "$-100.01"},
        {"currency": "JPY", "x": 0.5, "to_minor": 1, "format": "\u00a51"},
        {"currency": "JPY", "x": 1.5, "to_minor": 2, "format": "\u00a52"},
        {"currency": "JPY", "x": 2.5, "to_minor": 3, "format": "\u00a53"},
        {"currency": "JPY", "x": -0.5, "to_minor": -1, "format": "\u00a5-1"},
        {"currency": "JPY", "x": -1.5, "to_minor": -2, "format": "\u00a5-2"},
        {"currency": "JPY", "x": -2.5, "to_minor": -3, "format": "\u00a5-3"}
      ]},
      {"id": "rounding_edges", "description": "the floor(x + 0.5) cases: Python and JS gave a different answer from Go and Rust (D2)", "vectors": [
        {"currency": "JPY", "x": 0.49999999999999994, "to_minor": 0, "format": "\u00a50"},
        {"currency": "USD", "x": 0.004999999999999999, "to_minor": 0, "format": "$0.00"},
        {"currency": "JPY", "x": 4503599627370497.0, "to_minor": 4503599627370497, "format": "\u00a54503599627370497"},
        {"currency": "JPY", "x": 4503599627370499.0, "to_minor": 4503599627370499, "format": "\u00a54503599627370499"},
        {"currency": "JPY", "x": -4503599627370497.0, "to_minor": -4503599627370497, "format": "\u00a5-4503599627370497"},
        {"currency": "JPY", "x": 9007199254740991.0, "to_minor": 9007199254740991, "format": "\u00a59007199254740991"}
      ]},
      {"id": "overflow", "description": "to_minor errors when |r| >= 2^63 or the product is infinite; 18-decimal assets work below that (D3)", "vectors": [
        {"currency": "USD", "x": 1e+17, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": -1e+17, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": 1e+18, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": 9.223372036854776e+18, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": -9.223372036854776e+18, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": 1e+300, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": 1e+307, "to_minor": {"error": "overflow"}},
        {"currency": "USD", "x": -1e+307, "to_minor": {"error": "overflow"}},
        {"currency": "JPY", "x": 9.223372036854775e+18, "to_minor": 9223372036854774784},
        {"currency": "JPY", "x": -9.223372036854775e+18, "to_minor": -9223372036854774784},
        {"currency": "JPY", "x": 9.223372036854776e+18, "to_minor": {"error": "overflow"}},
        {"currency": "JPY", "x": -9.223372036854776e+18, "to_minor": {"error": "overflow"}},
        {"currency": "ETH", "x": 1.0, "to_minor": 1000000000000000000},
        {"currency": "ETH", "x": 9.0, "to_minor": 9000000000000000000},
        {"currency": "ETH", "x": -9.0, "to_minor": -9000000000000000000},
        {"currency": "ETH", "x": 9.3, "to_minor": {"error": "overflow"}},
        {"currency": "ETH", "x": 10.0, "to_minor": {"error": "overflow"}},
        {"currency": "ETH", "x": -10.0, "to_minor": {"error": "overflow"}}
      ]},
      {"id": "non_finite", "description": "NaN and +-Infinity; and finite amounts whose scaled product is infinite (D3, D5)", "vectors": [
        {"currency": "USD", "x": "NaN", "to_minor": {"error": "non_finite"}, "format": "$nan"},
        {"currency": "USD", "x": "Infinity", "to_minor": {"error": "non_finite"}, "format": "$inf"},
        {"currency": "USD", "x": "-Infinity", "to_minor": {"error": "non_finite"}, "format": "$-inf"},
        {"currency": "JPY", "x": "NaN", "to_minor": {"error": "non_finite"}, "format": "\u00a5nan"},
