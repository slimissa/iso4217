{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/slimissa/iso4217/v1.3.0/schema.json",
  "title": "ISO 4217 Currency Registry Schema",
  "description": "JSON Schema for the canonical ISO 4217 currency registry. Validates structure, types, patterns, and constraints for active ISO currencies, withdrawn currencies, and non-ISO financial instruments.",
  "type": "object",
  "required": ["meta", "source", "currencies"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "updated", "schema_version", "description", "project", "license"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the registry data."
        },
        "updated": {
          "type": "string",
          "format": "date",
          "description": "Date of last data update in ISO 8601 format."
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Version of this schema, decoupled from data version."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Human-readable description of the registry."
        },
        "project": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/",
          "description": "URL of the project repository."
        },
        "license": {
          "type": "string",
          "enum": ["Apache-2.0"],
          "description": "SPDX license identifier."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["standard", "maintenance_agency", "maintenance_agency_url", "last_amendment_applied", "last_amendment_date", "last_verified", "verified_against"],
      "additionalProperties": false,
      "properties": {
        "standard": {
          "type": "string",
          "enum": ["ISO 4217:2015"]
        },
        "maintenance_agency": {
          "type": "string",
          "enum": ["SIX Group"]
        },
        "maintenance_agency_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "last_amendment_applied": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "last_amendment_date": {
          "type": "string",
          "format": "date"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "verified_against": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "crypto_source": {
          "type": "string"
        },
        "stablecoin_source": {
          "type": "string"
        },
        "commodity_source": {
          "type": "string"
        }
      }
    },
    "currencies": {
      "type": "object",
      "required": ["active", "withdrawn"],
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/activeCurrency" }
        },
        "withdrawn": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/withdrawnCurrency" }
        }
      }
    },
    "non_iso": {
      "type": "object",
      "required": ["cryptocurrencies", "stablecoins", "commodities", "special_purpose"],
      "additionalProperties": false,
      "properties": {
        "cryptocurrencies": {
          "type": "array",
          "items": { "$ref": "#/definitions/cryptocurrency" }
        },
        "stablecoins": {
          "type": "array",
          "items": { "$ref": "#/definitions/stablecoin" }
        },
        "commodities": {
          "type": "array",
          "items": { "$ref": "#/definitions/commodity" }
        },
        "special_purpose": {
          "type": "array",
          "items": { "$ref": "#/definitions/specialPurpose" }
        }
      }
    }
  },
  "definitions": {
    "countryReference": {
      "type": "object",
      "required": ["code", "name", "relationship"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "description": "Human-readable country or territory name."
        },
        "relationship": {
          "type": "string",
          "enum": ["issuing", "adopting", "territory", "parallel", "local_issue"],
          "description": "Relationship of this country/territory to the currency."
        }
      }
    },
    "activeCurrency": {
      "type": "object",
      "required": ["code", "numeric", "name", "minor_units", "symbol", "entity", "central_bank", "pegged_to", "is_independent", "countries"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 alphabetic currency code. Always exactly 3 uppercase letters."
        },
        "numeric": {
          "type": "string",
          "pattern": "^\\d{3}$",
          "description": "ISO 4217 numeric currency code. Stored as string to preserve leading zeros."
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "description": "Official English name of the currency per ISO 4217."
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18,
          "description": "Number of decimal places for the minor currency unit."
        },
        "symbol": {
          "type": "string",
          "minLength": 0,
          "description": "Primary currency symbol for display purposes."
        },
        "entity": {
          "type": "string",
          "minLength": 2,
          "description": "The sovereign entity, monetary union, or organization that issues this currency."
        },
        "central_bank": {
          "type": "string",
          "minLength": 3,
          "description": "Official name of the central bank or monetary authority."
        },
        "pegged_to": {
          "description": "ISO 4217 code of the anchor currency (only when peg_type is 'single'), free-text description of a basket/undisclosed peg, or null if floating.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 3 }
          ]
        },
        "peg_type": {
          "description": "Classification of how pegged_to should be interpreted. 'single': pegged_to is a parseable ISO 4217 code (^[A-Z]{3}$). 'basket': pegged_to is a free-text description of a weighted-basket peg. 'undisclosed': pegged, but the peg mechanism/composition is not public — pegged_to is a free-text description. null/absent: not pegged. Required whenever pegged_to is non-null; consumers must check peg_type before assuming pegged_to is a parseable currency code.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "enum": ["single", "basket", "undisclosed"] }
          ]
        },
        "pegged_since": {
          "type": "string",
          "format": "date",
          "description": "Date the peg was established."
        },
        "peg_rate": {
          "description": "Official peg rate, or null for baskets/undisclosed pegs.",
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "peg_band_pct": {
          "description": "Allowed deviation from peg as percentage, or null.",
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 100 }
          ]
        },
        "is_independent": {
          "type": "boolean",
          "description": "true if the currency floats independently or managed float. false if hard-pegged."
        },
        "note": {
          "type": "string",
          "description": "Optional note for special cases."
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/countryReference" },
          "description": "Countries and territories where this currency is primary legal tender."
        }
      },
      "allOf": [
        {
          "$comment": "If pegged_to is a string (i.e. the currency is pegged to something), peg_type must be present and non-null so consumers know how to interpret pegged_to.",
          "if": {
            "properties": { "pegged_to": { "type": "string" } },
            "required": ["pegged_to"]
          },
          "then": {
            "required": ["peg_type"],
            "properties": { "peg_type": { "type": "string" } }
          }
        },
        {
          "$comment": "If peg_type is 'single', pegged_to must be a bare 3-letter ISO 4217 code, not a basket/undisclosed description.",
          "if": {
            "properties": { "peg_type": { "const": "single" } },
            "required": ["peg_type"]
          },
          "then": {
            "properties": { "pegged_to": { "type": "string", "pattern": "^[A-Z]{3}$" } }
          }
        },
        {
          "$comment": "If peg_type is 'basket' or 'undisclosed', pegged_to must NOT look like a bare 3-letter code — it must read as a description, catching cases where someone mislabels a real code as a basket/undisclosed peg or vice versa.",
          "if": {
            "properties": { "peg_type": { "enum": ["basket", "undisclosed"] } },
            "required": ["peg_type"]
          },
          "then": {
            "properties": { "pegged_to": { "type": "string", "not": { "pattern": "^[A-Z]{3}$" } } }
          }
        }
      ]
    },
    "withdrawnCurrency": {
      "type": "object",
      "required": ["code", "numeric", "name", "minor_units", "symbol", "entity", "withdrawn_date", "replaced_by", "conversion_rate"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,6}$",
          "description": "ISO 4217 alphabetic code, or suffixed code for revaluations (e.g., MXN_OLD)."
        },
        "numeric": {
          "type": "string",
          "pattern": "^\\d{3}$",
          "description": "ISO 4217 numeric code."
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "description": "Official English name."
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "symbol": {
          "type": "string",
          "minLength": 0
        },
        "entity": {
          "type": "string",
          "minLength": 2
        },
        "withdrawn_date": {
          "type": "string",
          "format": "date",
          "description": "Date the currency ceased to be legal tender."
        },
        "replaced_by": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the replacement currency."
        },
        "conversion_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Official conversion rate: units of this currency per 1 unit of replacement."
        },
        "note": {
          "type": "string",
          "description": "Optional note for unusual withdrawal circumstances."
        }
      }
    },
    "cryptocurrency": {
      "type": "object",
      "required": ["code", "name", "minor_units", "symbol", "type", "entity", "introduced", "market_cap_rank", "note"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$",
          "description": "Ticker symbol."
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "symbol": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "cryptocurrency"
        },
        "entity": {
          "type": "string",
          "minLength": 2
        },
        "introduced": {
          "type": "string",
          "format": "date"
        },
        "market_cap_rank": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "stablecoin": {
      "type": "object",
      "required": ["code", "name", "minor_units", "symbol", "type", "entity", "introduced", "market_cap_rank", "pegged_to", "peg_mechanism", "note"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "symbol": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "stablecoin"
        },
        "entity": {
          "type": "string",
          "minLength": 2
        },
        "introduced": {
          "type": "string",
          "format": "date"
        },
        "market_cap_rank": {
          "type": "integer",
          "minimum": 1
        },
        "pegged_to": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the fiat currency this stablecoin tracks."
        },
        "peg_mechanism": {
          "type": "string",
          "enum": [
            "Fiat-collateralized",
            "Crypto-overcollateralized",
            "Algorithmic",
            "Commodity-collateralized",
            "Hybrid"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "commodity": {
      "type": "object",
      "required": ["code", "name", "minor_units", "symbol", "type", "entity", "note"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^X[A-Z]{2}$",
          "description": "ISO 4217-compatible commodity code. Convention: 'X' prefix."
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "description": "Commodity name with standard trading unit."
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Practical convention for price precision. Not standardized by ISO."
        },
        "symbol": {
          "type": "string",
          "minLength": 3,
          "description": "Typically the code itself (XAU, XAG)."
        },
        "type": {
          "type": "string",
          "const": "commodity"
        },
        "entity": {
          "type": "string",
          "const": "N/A",
          "description": "Commodities have no issuing entity."
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "description": "Must clarify that minor_units is conventional and this is not a currency."
        }
      }
    },
    "specialPurpose": {
      "type": "object",
      "required": ["code", "name", "minor_units", "symbol", "type", "entity", "iso_status", "note"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,4}$",
          "description": "Code for this special purpose instrument."
        },
        "numeric": {
          "type": "string",
          "pattern": "^\\d{3}$",
          "description": "ISO 4217 numeric code, if one exists. Only applicable when iso_status is 'iso_code' or 'obsolete_iso' — market_convention codes have no ISO numeric assignment and should omit this field."
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "symbol": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["basket", "offshore", "unit_of_account", "other"],
          "description": "Classification of this special purpose instrument."
        },
        "entity": {
          "type": "string",
          "minLength": 2,
          "description": "Organization or market defining this instrument."
        },
        "iso_status": {
          "type": "string",
          "enum": ["iso_code", "market_convention", "obsolete_iso"],
          "description": "Ground truth for whether this code is officially defined in ISO 4217. 'iso_code': a currently-active code in the ISO 4217 standard (e.g. XDR, XUA, XSU) — not necessarily a tradable currency, but genuinely ISO-defined. 'market_convention': a code market participants use that is NOT part of ISO 4217 (e.g. CNH). 'obsolete_iso': was an ISO 4217 code but has since been withdrawn from the standard (distinct from currencies.withdrawn, which is for retired national currencies, not retired special-purpose codes). This field is authoritative — tools/validate.py uses it directly instead of inferring ISO status from the note text."
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "description": "Must explain relationship to ISO 4217 and usage context, consistent with iso_status."
        }
      }
    }
  }
}